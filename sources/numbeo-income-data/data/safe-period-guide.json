      "记录最近6-12个月的月经周期长度",
      "找出最短周期和最长周期",
      "易孕期开始日 = 最短周期 - 18",
      "易孕期结束日 = 最长周期 - 11",
      "易孕期之外的时间为安全期"
    ],
